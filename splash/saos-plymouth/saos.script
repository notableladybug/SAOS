// SAOS Plymouth Boot Splash

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

logo_x = Window.GetWidth() / 2 - logo_image.GetWidth() / 2;
logo_y = Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 40;
logo_sprite.SetPosition(logo_x, logo_y, 0);

// Brand text
brand_image = Image.Text("SAOS // SECRET AGENT OPERATING SYSTEM", 0, 1.0, 0.25, 1);
brand_sprite = Sprite(brand_image);
brand_sprite.SetPosition(
    Window.GetWidth() / 2 - brand_image.GetWidth() / 2,
    logo_y + logo_image.GetHeight() + 10,
    0
);

// Encryption prompt text
prompt_image = Image.Text("ENCRYPTION KEY: _", 0, 1.0, 0.25, 1);
prompt_sprite = Sprite(prompt_image);
prompt_sprite.SetPosition(
    Window.GetWidth() / 2 - prompt_image.GetWidth() / 2,
    bar_y + bar_height + 30,
    0
);

// Status text
status_image = Image.Text("INITIALIZING SECURE BOOT SEQUENCE...", 0, 1.0, 0.25, 1);
status_sprite = Sprite(status_image);
status_sprite.SetPosition(
    Window.GetWidth() / 2 - status_image.GetWidth() / 2,
    logo_y + logo_image.GetHeight() + 40,
    0
);

// Progress bar background
bar_width = 300;
bar_height = 4;
bar_x = Window.GetWidth() / 2 - bar_width / 2;
bar_y = logo_y + logo_image.GetHeight() + 50;

bar_bg = Rectangle();
bar_bg.SetSize(bar_width, bar_height);
bar_bg.SetColor(0, 0.1, 0, 1);
bar_bg_sprite = Sprite(bar_bg);
bar_bg_sprite.SetPosition(bar_x, bar_y, 0);

// Progress bar fill
progress_bar = Rectangle();
progress_bar.SetSize(0, bar_height);
progress_bar.SetColor(0, 1, 0.25, 1);
progress_sprite = Sprite(progress_bar);
progress_sprite.SetPosition(bar_x, bar_y, 1);

// Boot messages
messages = [
    "INITIALIZING SECURE BOOT SEQUENCE...",
    "LOADING ENCRYPTION MODULES...",
    "ESTABLISHING SECURE CHANNEL...",
    "AUTHENTICATING HARDWARE...",
    "LOADING AGENT INTERFACE...",
    "SYSTEM READY."
];

fun progress_callback(duration, progress) {
    progress_bar.SetSize(Math.Int(bar_width * progress), bar_height);
    progress_sprite.SetImage(progress_bar);

    msg_index = Math.Int(progress * (messages.Count - 1));
    if (msg_index >= messages.Count) {
        msg_index = messages.Count - 1;
    }

    new_status = Image.Text(messages[msg_index], 0, 1.0, 0.25, 1);
    status_sprite.SetImage(new_status);
    status_sprite.SetPosition(
        Window.GetWidth() / 2 - new_status.GetWidth() / 2,
        logo_y + logo_image.GetHeight() + 20,
        0
    );
}

Plymouth.SetBootProgressFunction(progress_callback);
